{
  "name": "duel-of-factions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx tests/engine.test.ts && node --import tsx tests/controller.test.ts",
    "format": "prettier --write src tests *.json *.ts README.md"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.6",
    "@analogjs/router": "2.9.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@quartz-headless/core": "^0.16.0",
    "@quartz-headless/primitives": "^0.16.0",
    "@voltui/components": "^1.3.3",
    "angular-movement": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ng-primitives": "^0.131.4",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@analogjs/platform": "2.9.6",
    "@angular/build": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "24.10.0",
    "jsdom": "^27.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.20.6",
    "typescript": "~6.0.2",
    "vite": "^7.3.0"
  }
}
