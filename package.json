{
  "name": "duel-of-factions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "node dist/analog/server/index.mjs",
    "test": "node --import tsx tests/engine.test.ts && node --import tsx tests/controller.test.ts && TSX_TSCONFIG_PATH=tsconfig.server.json node --import tsx tests/api.test.ts",
    "format": "prettier --write src tests *.json *.ts README.md"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.6",
    "@analogjs/router": "2.9.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@quartz-headless/core": "^0.16.0",
    "@quartz-headless/primitives": "^0.16.0",
    "@strata-sc/analog": "0.12.1",
    "@strata-sc/core": "0.2.2",
    "@strata-sc/server-components": "0.17.0",
    "@voltui/components": "^1.3.3",
    "angular-movement": "^1.2.0",
    "front-matter": "^4.0.2",
    "h3": "1.15.11",
    "lumen-icons": "^0.2.0",
    "nitropack": "2.13.6",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@agentyx/cli": "^0.24.0",
    "@analogjs/platform": "2.9.6",
    "@angular/build": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@standard-schema/spec": "1.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "24.10.0",
    "jsdom": "^27.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.20.6",
    "typescript": "~6.0.2",
    "vite": "~8.3.8"
  }
}
